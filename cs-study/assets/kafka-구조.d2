direction: right
vars: { d2-config: { pad: 30 } }
classes: {
  app:    { style: { fill: "#EAF2FF"; stroke: "#3B5BA5"; font-color: "#16213E"; border-radius: 8 } }
  broker: { style: { fill: "#FFFFFF"; stroke: "#5A6B7B"; font-color: "#16213E" } }
  part:   { shape: page; style: { fill: "#FFF1F6"; stroke: "#C2256B"; font-color: "#16213E" } }
  ctrl:   { style: { fill: "#FFF6E9"; stroke: "#C98A2B"; font-color: "#7A4E0A"; border-radius: 8 } }
}

producer: "Producer\nkey=filing_id → 파티션 결정" { class: app }

cluster: "Kafka Cluster (KRaft 모드)" {
  style: { stroke: "#0EA5E9"; stroke-dash: 4; fill: "#FFFFFF"; font-color: "#0369A1" }
  ctrl: "Controller Quorum (KRaft)\n메타데이터·리더 선출 (ZooKeeper 대체)" { class: ctrl }
  b1: "Broker 1" { class: broker; p0: "tax.filing  P0 (leader)\noffset 0,1,2,…" { class: part } }
  b2: "Broker 2" { class: broker; p1: "tax.filing  P1 (leader)\noffset 0,1,2,…" { class: part } }
  b3: "Broker 3" { class: broker; p2: "tax.filing  P2 (leader)\noffset 0,1,2,…" { class: part } }
}

g1: "Consumer Group: 알림" {
  style: { stroke: "#3B5BA5"; fill: "#F5F8FF"; font-color: "#16213E" }
  c1: "Consumer A" { class: app }
  c2: "Consumer B" { class: app }
}
g2: "Consumer Group: 회계" {
  style: { stroke: "#3F8E55"; fill: "#F1FBF4"; font-color: "#14532D" }
  c3: "Consumer C" { class: app }
}

producer -> cluster.b1.p0
producer -> cluster.b2.p1
producer -> cluster.b3.p2

cluster.b1.p0 -> g1.c1: "구독"
cluster.b2.p1 -> g1.c1
cluster.b3.p2 -> g1.c2
cluster.b1.p0 -> g2.c3
cluster.b2.p1 -> g2.c3
cluster.b3.p2 -> g2.c3
