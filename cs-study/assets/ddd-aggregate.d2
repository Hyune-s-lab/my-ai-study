direction: right
vars: { d2-config: { pad: 30 } }
classes: {
  root: { style: { fill: "#EAF2FF"; stroke: "#3B5BA5"; font-color: "#16213E"; bold: true } }
  vo:   { style: { fill: "#F4F4F5"; stroke: "#9AA0A6"; font-color: "#16191F" } }
}

ord: "Order 애그리거트" {
  style: { stroke: "#3F8E55"; stroke-dash: 3; fill: "#F7FCF9" }
  r: "Order  «root»" { class: root }
  s: "shipping_address «VO»" { class: vo }
  v: "total_amount «VO»" { class: vo }
  r -> s
  r -> v
}
pay: "Payment 애그리거트" {
  style: { stroke: "#3F8E55"; stroke-dash: 3; fill: "#F7FCF9" }
  r: "Payment  «root»" { class: root }
  p: "payment_snapshot «VO»" { class: vo }
  r -> p
}
shp: "Shipping 애그리거트" {
  style: { stroke: "#3F8E55"; stroke-dash: 3; fill: "#F7FCF9" }
  r: "Shipping  «root»" { class: root }
}

pay.r -> ord.r: "order_id (ID 참조, 객체 X)" { style: { stroke: "#C2256B"; stroke-dash: 4 } }
shp.r -> ord.r: "order_id (ID 참조)" { style: { stroke: "#C2256B"; stroke-dash: 4 } }
