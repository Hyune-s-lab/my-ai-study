vars: { d2-config: { pad: 30 } }
classes: {
  db:   { style: { fill: "#EAF7EE"; stroke: "#3F8E55"; font-color: "#14532D" } }
  part: { shape: cylinder; style: { fill: "#EAF2FF"; stroke: "#3B5BA5"; font-color: "#16213E" } }
  tbl:  { style: { fill: "#EAF2FF"; stroke: "#3B5BA5"; font-color: "#16213E" } }
  app:  { style: { fill: "#FFF6E9"; stroke: "#C98A2B"; font-color: "#7A4E0A"; border-radius: 8 } }
}
cmp: "" {
  style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }
  grid-columns: 3
  grid-gap: 90

  h: "① 수평 파티셔닝  (행 분할 · 단일 DB)" {
    style: { stroke: "#3B5BA5"; stroke-dash: 3 }
    db: "PostgreSQL" {
      class: db
      p1: "rows · 2023" { class: part }
      p2: "rows · 2024" { class: part }
      p3: "rows · 2025" { class: part }
    }
  }
  v: "② 수직 파티셔닝  (컬럼 분할 · 단일 DB)" {
    style: { stroke: "#C98A2B"; stroke-dash: 3 }
    db: "PostgreSQL" {
      class: db
      t1: "filing\n(id, status, …)  ← hot" { class: tbl }
      t2: "filing_payload\n(id, payload_snapshot)  ← cold" { class: tbl }
      t1 -> t2: "같은 PK"
    }
  }
  s: "③ 샤딩  (행 분할 · 여러 노드)" {
    style: { stroke: "#C2256B"; stroke-dash: 3 }
    router: "샤드 라우터\n(shard key)" { class: app }
    n1: "Node 1" { class: db; s1: "Shard 1" { class: part } }
    n2: "Node 2" { class: db; s2: "Shard 2" { class: part } }
    n3: "Node 3" { class: db; s3: "Shard 3" { class: part } }
    router -> n1.s1
    router -> n2.s2
    router -> n3.s3
  }
}
