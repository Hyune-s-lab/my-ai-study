direction: down
vars: { d2-config: { pad: 30 } }
classes: {
  q:    { style: { fill: "#FFF6E9"; stroke: "#C98A2B"; font-color: "#7A4E0A"; border-radius: 8 } }
  node: { style: { fill: "#EAF2FF"; stroke: "#3B5BA5"; font-color: "#16213E" } }
  heap: { shape: cylinder; style: { fill: "#EAF7EE"; stroke: "#3F8E55"; font-color: "#14532D" } }
}
q: "쿼리: WHERE filing_id = 35" { class: q }

idx: "B-tree 인덱스 (정렬된 구조)" {
  style: { stroke: "#3B5BA5"; fill: "#FBFCFE" }
  root: "Root\n[ 40 ]" { class: node }
  l: "< 40\n[10 · 25 · 35]" { class: node }
  r: "≥ 40\n[40 · 60 · 90]" { class: node }
  root -> l: "35 < 40"
  root -> r
}
heap: "Heap (실제 행 데이터)\n…  filing_id=35 행  …" { class: heap }

q -> idx.root
idx.l -> heap: "행 포인터(ctid)로 점프"

note: |md
  - 인덱스 없으면 **Seq Scan**: 전 행을 처음부터 훑음 O(n).
  - B-tree 있으면 **Index Scan**: 정렬 트리로 O(log n) 탐색 → 행 위치로 점프.
| { near: bottom-center }
