direction: right
vars: { d2-config: { pad: 40 } }
classes: {
  svc: { shape: image; width: 64; height: 64 }
  ext: { shape: rectangle; style: { fill: "#F4F4F5"; stroke: "#9AA0A6"; stroke-dash: 4; border-radius: 8; font-color: "#16191F" } }
}
c: "클라이언트" { class: svc; icon: https://icons.terrastruct.com/aws%2F_General%2FUsers_light-bg.svg }
api: "API 서버 (동기)\n요청 스레드 점유" { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
nts: "국세청 (외부)\n응답 수십 초~분" { class: ext }
calc: "계산 엔진" { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
c -> api: "1. 요청"
api -> nts: "2. 수집(느림)" { style: { stroke: "#D13212"; font-color: "#D13212" } }
nts -> calc: "3. 계산"
