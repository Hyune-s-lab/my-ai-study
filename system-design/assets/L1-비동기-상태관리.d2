direction: right
vars: { d2-config: { pad: 40 } }
classes: {
  svc: { shape: image; width: 64; height: 64 }
  ext: { shape: rectangle; style: { fill: "#F4F4F5"; stroke: "#9AA0A6"; stroke-dash: 4; border-radius: 8; font-color: "#16191F" } }
  st:    { style: { fill: "#FFFFFF"; stroke: "#22C55E"; font-color: "#14532D"; border-radius: 6 } }
  stok:  { style: { fill: "#DCFCE7"; stroke: "#16A34A"; font-color: "#14532D"; border-radius: 6 } }
  sterr: { style: { fill: "#FFF7ED"; stroke: "#F97316"; font-color: "#7C2D12"; border-radius: 6 } }
}
c: "클라이언트\njobId 폴링" { class: svc; icon: https://icons.terrastruct.com/aws%2F_General%2FUsers_light-bg.svg }
nts: "국세청 (외부)" { class: ext }
apigw: "라우팅" { class: svc; icon: https://icons.terrastruct.com/aws%2FMobile%2FAmazon-API-Gateway.svg }
api: "API\n잡 생성·jobId" { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
kafka: "잡 토픽" { class: svc; icon: https://icons.terrastruct.com/aws%2FAnalytics%2FAmazon-Managed-Streaming-for-Kafka.svg }
worker: "Worker\n수집→계산" { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
calc: "계산 엔진" { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
ddb: "잡 상태·결과" { class: svc; icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-DynamoDB.svg }
sm: "상태 머신 (jobId)" {
  style: { stroke: "#22C55E"; fill: "#FFFFFF"; font-color: "#15803D" }
  s1: "REQUESTED" { class: st }
  s2: "COLLECTING" { class: st }
  s3: "CALCULATING" { class: st }
  s4: "READY (미리보기)" { class: stok }
  s5: "FAILED/재시도" { class: sterr }
  s1 -> s2 -> s3 -> s4
  s3 -> s5 { style.stroke-dash: 4 }
}
c -> apigw: "요청·폴링"
apigw -> api
api -> kafka: "발행"
kafka -> worker: "구독"
worker -> nts: "수집" { style: { stroke: "#D13212"; font-color: "#D13212" } }
worker -> calc: "계산"
worker -> ddb: "상태/결과"
api -> ddb: "상태 조회" { style: { stroke-dash: 4; stroke: "#147EBA"; font-color: "#147EBA" } }
ddb -> sm.s1: "상태 전이" { style: { stroke-dash: 4; stroke: "#22C55E"; font-color: "#15803D" } }
