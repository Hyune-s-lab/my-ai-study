direction: right
vars: { d2-config: { pad: 40 } }
classes: {
  svc: { shape: image; width: 64; height: 64 }
  ext: { shape: rectangle; style: { fill: "#F4F4F5"; stroke: "#9AA0A6"; stroke-dash: 4; border-radius: 8; font-color: "#16191F" } }
}
client: "클라이언트\n(모바일 앱)" { class: svc; icon: https://icons.terrastruct.com/aws%2F_General%2FUsers_light-bg.svg }
nts: "국세청 홈택스/손택스\n(외부 · 느림)" { class: ext }
aws: "AWS Cloud" {
  style: { stroke: "#232F3E"; fill: "#FFFFFF"; font-color: "#232F3E"; stroke-width: 2 }
  apigw:  "인증·라우팅"          { class: svc; icon: https://icons.terrastruct.com/aws%2FMobile%2FAmazon-API-Gateway.svg }
  api:    "API\n잡 생성·jobId"    { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
  kafka:  "잡 토픽 + DLT"         { class: svc; icon: https://icons.terrastruct.com/aws%2FAnalytics%2FAmazon-Managed-Streaming-for-Kafka.svg }
  worker: "Worker\n수집·Retry·CB" { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
  calc:   "계산 엔진\n세법 룰"     { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
  ddb:    "상태·멱등키"           { class: svc; icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-DynamoDB.svg }
  cache:  "수집 캐시"             { class: svc; icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-ElastiCache.svg }
  s3:     "원천·신고서"           { class: svc; icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg }
  notif:  "알림 서비스\nFCM/APNs 푸시" { class: svc; icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Fargate.svg }
  sfn:    "셀프 신고 사가"         { class: svc; icon: https://icons.terrastruct.com/aws%2FApplication%20Integration%2FAWS-Step-Functions.svg }
}
client -> aws.apigw: "요청·폴링"
aws.apigw -> aws.api
aws.api -> aws.kafka: "발행"
aws.kafka -> aws.worker: "구독"
aws.worker -> aws.calc: "계산"
aws.worker -> nts: "수집" { style: { stroke: "#D13212"; font-color: "#D13212" } }
aws.worker -> aws.ddb: "상태/결과 저장"
aws.worker -> aws.cache: "캐시"
aws.worker -> aws.s3
aws.worker -> aws.notif: "완료 이벤트"
aws.notif -> client: "푸시" { style.stroke-dash: 4 }
aws.api -> aws.ddb: "상태 조회" { style: { stroke-dash: 4; stroke: "#147EBA"; font-color: "#147EBA" } }
aws.apigw -> aws.sfn: "제출 요청"
aws.sfn -> nts: "제출(멱등키)" { style: { stroke: "#D13212"; font-color: "#D13212" } }
aws.sfn -> aws.ddb: "제출상태"
